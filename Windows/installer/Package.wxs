<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Afterglow" Manufacturer="Afterglow" Version="$(var.Version)"
           UpgradeCode="$(var.UpgradeCode)" Scope="perMachine" Compressed="yes">
    <SummaryInformation Description="Afterglow system monitor" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Afterglow is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="Afterglow.ico" SourceFile="..\Afterglow.Windows\Afterglow.ico" />
    <Property Id="ARPPRODUCTICON" Value="Afterglow.ico" />
    <Property Id="ARPCOMMENTS" Value="System monitor" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.EulaPath)" />
    <!-- The last page of setup offers "Run after install?", ticked by default. WixShellExec launches the app through the
         shell so its manifest can ask for administrator. Silent installs show no UI, so they never launch it. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Run after install?" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchAfterglow" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
      <!-- Set the target when Finish is clicked, so it uses the folder the user chose. -->
      <Publish Dialog="ExitDialog" Control="Finish" Property="WixShellExecTarget" Value="[INSTALLFOLDER]Afterglow.exe" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchAfterglow" Order="2" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- PawnIO is the signed sensor driver LibreHardwareMonitor uses for CPU temperature and package power.
         installer.ps1 pins it by SHA-256 and checks the namazso signature. It runs from the MSI, so there is one installer.
         Setup does not fail if the driver install fails; Afterglow then shows those readings as unavailable.
         Uninstalling Afterglow leaves PawnIO installed because other monitoring tools share it. -->
    <Binary Id="PawnIOSetup" SourceFile="$(var.PawnIoSetup)" />
    <CustomAction Id="InstallPawnIO" BinaryRef="PawnIOSetup" ExeCommand="-install -silent" Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="InstallPawnIO" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Afterglow">
        <Files Include="$(var.PublishDir)**">
          <Exclude Files="$(var.PublishDir)**\*.pdb" />
          <Exclude Files="$(var.PublishDir)**\*.md" />
        </Files>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="8E4C1A70-2B55-4F19-9A6D-1C3E7B0A5D22">
        <Shortcut Id="StartMenuAfterglow" Name="Afterglow" Description="System monitor"
                  Target="[INSTALLFOLDER]Afterglow.exe" WorkingDirectory="INSTALLFOLDER" Icon="Afterglow.ico" />
        <RegistryValue Root="HKCU" Key="Software\Afterglow" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="F19A6C33-0D47-4E82-B5A1-7C2D8E4F6A10">
        <Shortcut Id="DesktopAfterglow" Name="Afterglow" Description="System monitor"
                  Target="[INSTALLFOLDER]Afterglow.exe" WorkingDirectory="INSTALLFOLDER" Icon="Afterglow.ico" />
        <RegistryValue Root="HKCU" Key="Software\Afterglow" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
